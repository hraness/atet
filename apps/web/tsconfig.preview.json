{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "verbatimModuleSyntax": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["bun"]
  },
  "include": [
    "scripts/build-preview.ts",
    "scripts/preview-contract.ts",
    "scripts/preview-contract.test.ts",
    "scripts/preview-css.ts",
    "scripts/preview-css.test.ts",
    "scripts/preview-file.ts",
    "scripts/preview-file.test.ts",
    "src/preview-renderer.ts",
    "src/preview-foundation.ts",
    "src/preview.stylex.ts"
  ]
}
