{
  "name": "@cclrte/diagram",
  "version": "0.1.0",
  "description": "A headless diagram CLI and Agent Skill with themed exports and tldraw interoperability.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "packageManager": "bun@1.3.14",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hraness/diagram.git"
  },
  "homepage": "https://github.com/hraness/diagram#readme",
  "bugs": {
    "url": "https://github.com/hraness/diagram/issues"
  },
  "keywords": [
    "diagram",
    "tldraw",
    "agent-skill",
    "svg",
    "visualization"
  ],
  "bin": {
    "diagram": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "files": [
    "dist",
    "examples/capex-opex.diagram.json",
    "examples/diagram.config.ts",
    "schema",
    "skills",
    "src/artifacts.ts",
    "src/config.ts",
    "src/desktop.ts",
    "src/fs.ts",
    "src/icons.ts",
    "src/index.ts",
    "src/lint.ts",
    "src/parse.ts",
    "src/render.ts",
    "src/skill-install.ts",
    "src/theme.ts",
    "src/tldr.ts",
    "src/types.ts",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "scripts": {
    "build": "bun -e 'await (await import(\"node:fs/promises\")).rm(\"./dist\", { recursive: true, force: true })' && bun build ./src/cli.ts --outfile ./dist/cli.js --target bun --format esm --packages external && bun build ./src/index.ts --outfile ./dist/index.js --target bun --format esm --packages external",
    "typecheck": "tsc --noEmit",
    "test": "bun test ./src ./scripts",
    "test:package": "bun run ./scripts/package-smoke.ts",
    "example": "bun run ./src/cli.ts render ./examples/capex-opex.diagram.json --out-dir ./examples/output",
    "check:skill": "bun run ./scripts/validate-skill.ts",
    "check": "bun run typecheck && bun run test && bun run build && bun run check:skill && bun run test:package",
    "prepack": "bun run check"
  },
  "dependencies": {
    "@resvg/resvg-js": "2.6.2"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "fast-check": "4.8.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tldraw": "5.2.5",
    "typescript": "6.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
